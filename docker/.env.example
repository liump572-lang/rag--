# ==============================================
# 环境配置文件模板
# 使用方式:
#   cp .env.example .env
#   # 编辑 .env 填入实际值
#   docker compose up -d
# ==============================================

# MySQL
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=knowledge_qa_system
MYSQL_USER=qa_app
MYSQL_PASSWORD=change-this-db-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Neo4j
NEO4J_AUTH=neo4j/change-this-neo4j-password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# DeepSeek LLM (required)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=deepseek-embedding
EMBEDDING_DIM=1024

# JWT (change in production)
JWT_SECRET_KEY=generate-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload directory
UPLOAD_DIR=/app/uploads
